{
  "name": "containers",
  "version": "0.1.0",
  "private": true,
  "description": "See a project's container stack from its Compose files: a map, readiness checks with suggested edits, and short answers for agents.",
  "author": "shellkah",
  "type": "module",
  "scripts": {
    "build": "jensen-plugin build",
    "dev": "jensen-plugin dev",
    "validate": "jensen-plugin validate",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --error-on-warnings .",
    "test": "bun test ./test",
    "test:backend": "cargo test --manifest-path backend/Cargo.toml",
    "check": "make check"
  },
  "dependencies": {
    "@jensen-org/plugin-sdk": "^0.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.3"
  },
  "jensen": {
    "id": "dev.jensen.containers",
    "displayName": "Containers",
    "category": "devtools",
    "repo": "shellkah/jensen-containers",
    "minAppVersion": "0.3.0",
    "backend": "backend.wasm",
    "backendBuild": "cargo build --release --target wasm32-unknown-unknown --manifest-path backend/Cargo.toml && cp backend/target/wasm32-unknown-unknown/release/containers.wasm backend.wasm",
    "permissions": {
      "workspace": true,
      "editor": "write",
      "graph": true,
      "backend": true,
      "fs": [
        "*.yaml",
        "*.yml"
      ]
    }
  }
}
